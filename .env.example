# Server configuration (Render Web Service)
PORT=3000
NODE_ENV=development

# Optional Gemini API key (used as fallback for rare slang/modern words in Spanish validation)
GEMINI_API_KEY=

# CORS / Allowed Origins for Render Web Service (comma-separated)
# Set this in your Render Web Service environment variables:
# e.g., ALLOWED_ORIGINS=https://fam2play-web.onrender.com,https://fam2play.com,https://www.fam2play.com
ALLOWED_ORIGINS=https://fam2play-web.onrender.com

# Frontend build-time variables (Render Static Site)
# Set these build-time environment variables in your Render Static Site dashboard:
# VITE_API_BASE_URL=https://fam2play.onrender.com
# VITE_WS_BASE_URL=wss://fam2play.onrender.com
